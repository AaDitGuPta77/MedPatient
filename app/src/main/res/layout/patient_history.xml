<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="16dp"
    android:background="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/tvPatientName"
            android:layout_width="0px"
            android:layout_weight="5"
            android:layout_height="wrap_content"
            android:text="Medical Records"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="@color/black"
            android:layout_marginBottom="10dp"/>

        <ImageView
            android:id="@+id/back_arrow"
            android:layout_width="0px"
            android:layout_weight="1"
            android:layout_height="wrap_content"

            android:src="@drawable/arrow_symbol" />
    </LinearLayout>

    <RelativeLayout
        xmlns:android="http://schemas.android.com/apk/res/android"
        xmlns:app="http://schemas.android.com/apk/res-auto"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <!-- RecyclerView to display medical records -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewMedicalRecords"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/fab_add_record"
            android:padding="8dp" />

        <!-- Floating Action Button -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fab_add_record"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:layout_alignParentEnd="true"
            android:layout_margin="16dp"
            app:srcCompat="@drawable/ic_add"
            app:tint="@android:color/white"
            app:backgroundTint="@color/teal_200" />
    </RelativeLayout>

</LinearLayout>
